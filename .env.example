RESEND_API_KEY=re_replace_with_your_api_key
QUOTE_FROM_EMAIL=My Carport Guy <quotes@mycarportguy.com>

# Hosted catalog API on the existing SomePvP server
CATALOG_API_URL=https://catalog.mycarportguy.com
CATALOG_API_TOKEN=replace_with_a_long_random_token
# Optional; defaults to /root/mycarportguy-data/quotes.json on the private server
CATALOG_QUOTES_FILE=/root/mycarportguy-data/quotes.json

# Private /admin login
ADMIN_PASSWORD_HASH=generated_by_the_local_admin_setup_screen
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Google Analytics 4 web stream (Google provides an ID beginning with G-)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Square production invoicing and signed payment notifications
SQUARE_ACCESS_TOKEN=replace_with_your_square_production_token
SQUARE_LOCATION_ID=replace_with_your_square_location_id
SQUARE_WEBHOOK_SIGNATURE_KEY=replace_with_the_square_webhook_signature_key
SQUARE_WEBHOOK_URL=https://www.mycarportguy.com/api/webhooks/square
